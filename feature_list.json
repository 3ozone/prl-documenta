                "title": "Documento de Identidad (DNI / NIE / Pasaporte)",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "multi_annual",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "emp_002",
                "name": "ficha_informacion_riesgos",
                "title": "Ficha de Información de Riesgos (Art. 18 LPRL)",
                "legal_reference": "Art. 18 LPRL 31/1995",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "emp_003",
                "name": "ficha_formacion_riesgos",
                "title": "Ficha de Formación de Riesgos (Art. 19 LPRL)",
                "legal_reference": "Art. 19 LPRL 31/1995",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "emp_004",
                "name": "certificado_aptitud_medica",
                "title": "Certificado de Aptitud Médica (Vigilancia de la Salud)",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
