                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_002",
                "name": "certificado_corriente_pago_seguridad_social",
                "title": "Certificado de estar al corriente de pago con la Seguridad Social",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_003",
                "name": "rlc_recibo_liquidacion_cotizaciones",
                "title": "RLC - Recibo de Liquidación de Cotizaciones",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "monthly",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_004",
                "name": "rnt_relacion_nominal_trabajadores",
                "title": "RNT - Relación Nominal de Trabajadores",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "monthly",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_005",
                "name": "poliza_responsabilidad_civil",
                "title": "Póliza de Responsabilidad Civil y recibo de pago vigente",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "includes": [
                    "poliza",
                    "recibo_pago"
                ],
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_006",
                "name": "poliza_accidentes_trabajo",
                "title": "Póliza de Accidentes de Trabajo y recibo de pago vigente",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "includes": [
                    "poliza",
                    "recibo_pago"
                ],
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_007",
                "name": "documento_adhesion_mutua",
                "title": "Documento de adhesión a la Mutua",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": false,
                "cadence": "indefinite",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_008",
                "name": "contrato_servicio_prevencion_ajeno",
                "title": "Contrato del Servicio de Prevención Ajeno (SPA) - modalidad y certificado de pago",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "includes": [
                    "contrato",
                    "modalidad_preventiva",
                    "certificado_pago"
                ],
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_009",
                "name": "rea_registro_empresas_acreditadas",
                "title": "REA - Registro de Empresas Acreditadas (construcción)",
                "is_mandatory": false,
                "applies_to_sectors": [
                    "construccion"
                ],
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "company_010",
                "name": "plan_prevencion_evaluacion_riesgos",
                "title": "Plan de Prevención y Evaluación de Riesgos Laborales (ERL)",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": false,
                "cadence": "indefinite",
                "requires_periodic_review": true,
                "review_interval_years": 2,
                "formats_allowed": [
                    "pdf"
                ]
            }
        ]
    },
    "employee_documentation": {
        "enabled": true,
        "description": "Documentación obligatoria por empleado para PRL y CAE.",
        "documents": [
            {
                "id": "emp_001",
