    "equipment_documentation": {
        "enabled": true,
        "description": "Documentación obligatoria para maquinaria, extintores, botiquines y equipos de trabajo. Referencia: RD 1215/97.",
        "documents": [
            {
                "id": "equip_001",
                "name": "declaracion_conformidad_ce",
                "title": "Declaración de Conformidad CE / Certificación RD 1215/97",
                "legal_reference": "RD 1215/1997",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": false,
                "cadence": "indefinite",
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "equip_002",
                "name": "registro_inspecciones_tecnicas",
                "title": "Registro de Inspecciones Técnicas / Revisiones Obligatorias",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "annual",
                "fields": {
                    "organismo_inspector": "string",
                    "resultado_inspeccion": [
                        "favorable",
                        "condicionado",
                        "desfavorable"
                    ],
                    "fecha_proxima_inspeccion": "date"
                },
                "formats_allowed": [
                    "pdf"
                ]
            },
            {
                "id": "equip_003",
                "name": "ficha_mantenimiento",
                "title": "Ficha de Mantenimiento Preventivo / Correctivo",
                "is_mandatory": true,
                "requires_start_date": true,
                "requires_expiry_date": true,
                "cadence": "periodic",
                "fields": {
                    "tipo_mantenimiento": [
                        "preventivo",
                        "correctivo"
                    ],
                    "empresa_mantenedora": "string",
                    "fecha_proximo_mantenimiento": "date"
                },
                "formats_allowed": [
                    "pdf"
                ]
            }
        ]
    },
    "expiration_rules": {
        "enabled": true,
        "description": "Reglas de alerta diferenciadas según la cadencia de caducidad del documento.",
        "rules": [
            {
                "id": "rule_monthly",
                "name": "alerta_documentos_mensuales",
                "title": "Alertas para documentos mensuales",
                "applies_to_cadence": [
                    "monthly"
                ],
                "applies_to_document_ids": [
                    "company_003",
                    "company_004"
                ],
                "thresholds_days": [
                    5
                ],
                "levels": [
                    {
                        "days_before": 5,
                        "level": "alerta_critica",
                        "notification": [
                            "email",
                            "panel_interno"
                        ]
                    }
                ]
            },
            {
                "id": "rule_annual_multi_annual",
                "name": "alerta_documentos_anuales_plurianuales",
                "title": "Alertas para documentos anuales o plurianuales",
                "applies_to_cadence": [
                    "annual",
                    "multi_annual"
                ],
                "applies_to_document_ids": [
                    "company_001",
                    "company_002",
                    "company_005",
                    "company_006",
                    "company_008",
                    "company_009",
                    "emp_001",
                    "emp_002",
                    "emp_003",
                    "emp_004",
                    "emp_006",
                    "emp_007",
                    "equip_002",
                    "equip_003"
                ],
                "thresholds_days": [
                    30,
                    15
                ],
                "levels": [
                    {
                        "days_before": 30,
                        "level": "aviso",
                        "notification": [
                            "panel_interno"
                        ]
                    },
                    {
                        "days_before": 15,
                        "level": "alerta",
                        "notification": [
                            "email",
                            "panel_interno"
                        ]
                    }
                ]
            }
        ]
    }
}