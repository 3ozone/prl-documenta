{
    "project": "prl-documenta",
    "description": "Sistema de gestión documental de Prevención de Riesgos Laborales (PRL) y CAE. Referencia normativa: LPRL 31/1995.",
    "version": "1.0.0",
    "rules": {
        "one_feature_at_a_time": true,
        "require_tests_to_close": true,
        "require_approved_spec_to_implement": true,
        "valid_status": [
            "pending",
            "spec_ready",
            "in_progress",
            "done",
            "blocked"
        ],
        "sdd_required_when": "feature has \"sdd\": true"
    },
    "features": [
        {
            "id": 1,
            "name": "core_upload",
            "title": "Subida de documentos",
            "description": "Permite subir documentos al sistema. Solo se admite formato PDF. Cada documento requiere id único, nombre, fecha_validez y fecha_caducidad.",
            "category": "core_features",
            "enabled": true,
            "config": {
                "formatos_permitidos": [
                    "pdf"
                ],
                "campos_obligatorios": [
                    "id",
                    "nombre_archivo",
                    "formato",
                    "fecha_validez",
                    "fecha_caducidad"
                ]
            },
            "acceptance": [
                "Solo se aceptan archivos en formato PDF",
                "El sistema rechaza el upload si falta algún campo obligatorio",
                "Se genera un id único por documento en cada subida",
                "fecha_caducidad debe ser posterior a fecha_validez"
            ],
            "sdd": true,
            "status": "pending"
        },
        {
            "id": 2,
            "name": "core_download",
            "title": "Descarga de documentos",
            "description": "Permite descargar cualquier documento almacenado por su id único.",
            "category": "core_features",
            "enabled": true,
            "config": {
                "requiere_autenticacion": true
            },
            "acceptance": [
                "El documento se descarga en su formato original (PDF)",
                "Devuelve error claro si el id no existe",
                "El acceso requiere autenticación"
            ],
            "sdd": true,
            "status": "pending"
        },
        {
            "id": 3,
            "name": "core_reporting",
            "title": "Generación de informes de estado documental",
            "description": "Genera informes con el estado de la documentación clasificado en: Vigente, Próxima a caducar y Caducada.",
            "category": "core_features",
            "enabled": true,
            "config": {
                "estados_posibles": [
                    "vigente",
                    "proxima_a_caducar",
                    "caducada"
                ],
                "formatos_exportacion": [
                    "pdf",
                    "csv"
                ]
            },
            "acceptance": [
                "El informe incluye una sección por cada estado posible",
                "Puede filtrarse por categoría (empresa, trabajadores, equipos)",
                "Exportable en PDF y CSV",
                "Refleja el estado a fecha del momento de generación"
            ],
            "sdd": true,
            "status": "pending"
        },
        {
            "id": 4,
            "name": "category_empresa",
            "title": "Categoría: Documentación de Empresa",
            "description": "Gestión de la documentación corporativa general de PRL (plan de prevención, evaluaciones de riesgo, etc.).",
            "category": "document_categories",
            "enabled": true,
            "config": {
                "slug": "empresa",
                "campos_especificos": [
                    "razon_social",
                    "cif",
                    "actividad_economica",
                    "centro_trabajo"
                ]
            },
            "acceptance": [
                "Los documentos de empresa incluyen los campos específicos de la categoría",
                "Se pueden listar todos los documentos de empresa paginados",
                "El filtrado por estado (vigente / caducado) funciona correctamente"
            ],
            "sdd": true,
            "status": "pending"
        },
        {
            "id": 5,
            "name": "category_trabajadores",
            "title": "Categoría: Documentación de Trabajadores",
            "description": "Documentos asociados a empleados: formaciones, reconocimientos médicos, EPIs entregados, etc.",
            "category": "document_categories",
            "enabled": true,
            "config": {
                "slug": "trabajadores",
                "campos_especificos": [
                    "nombre_trabajador",
                    "dni",
                    "puesto",
                    "tipo_documento"
                ],
                "tipos_documento": [
                    "formacion",
                    "reconocimiento_medico",
                    "entrega_epi",
                    "aptitud_medica"
                ]
            },
            "acceptance": [
                "Cada documento está vinculado a un trabajador por DNI",
                "El tipo de documento debe pertenecer a la lista de tipos permitidos",
                "Se pueden listar todos los documentos de un trabajador concreto"
            ],
            "sdd": true,
            "status": "pending"
        },
        {
            "id": 6,
            "name": "category_equipos",
            "title": "Categoría: Documentación de Equipos y Maquinaria",
            "description": "Documentación asociada a maquinaria y equipos de trabajo. Incluye sub-tipos específicos para mantenimientos e inspecciones.",
            "category": "document_categories",
            "enabled": true,
            "config": {
                "slug": "equipos",
                "campos_especificos": [
                    "id_equipo",
                    "nombre_equipo",
                    "numero_serie",
                    "ubicacion"
                ],
                "subtipos": {
                    "mantenimiento": {
                        "campos": [
                            "tipo_mantenimiento",
                            "empresa_mantenedora",
                            "fecha_proximo_mantenimiento"
                        ]
                    },
                    "inspeccion": {
                        "campos": [
                            "organismo_inspector",
                            "resultado_inspeccion",
                            "fecha_proxima_inspeccion"
                        ]
                    }
                }
            },
            "acceptance": [
                "Cada documento de equipo está vinculado a un id_equipo",
                "Los documentos de tipo mantenimiento incluyen los campos de mantenimiento",
                "Los documentos de tipo inspección incluyen los campos de inspección",
                "Se pueden listar todos los documentos de un equipo concreto"
            ],
            "sdd": true,
            "status": "pending"
        },
        {
            "id": 7,
            "name": "alert_system",
            "title": "Sistema de alertas por caducidad",
            "description": "Genera avisos y alertas automáticas en función de los días restantes hasta la fecha_caducidad de cada documento.",
            "category": "alert_system",
            "enabled": true,
            "config": {
                "umbrales_dias": {
                    "aviso": 30,
                    "alerta": 15,
                    "alerta_critica": 5
                },
                "notificaciones": {
                    "email": true,
                    "panel_interno": true
                }
            },
            "acceptance": [
                "A 30 días de la caducidad se genera un aviso",
                "A 15 días se genera una alerta",
                "A 5 días se genera una alerta crítica",
                "Los documentos ya caducados aparecen marcados como 'caducada' en el panel",
                "Las notificaciones por email y panel interno son configurables de forma independiente"
            ],
            "sdd": true,
            "status": "pending"
        }
    ],
    "company_documentation": {
        "enabled": true,
        "description": "Documentación corporativa obligatoria de la empresa para PRL y CAE.",
        "documents": [
            {
                "id": "company_001",
                "name": "certificado_corriente_pago_aeat",
